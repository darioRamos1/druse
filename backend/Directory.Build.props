<Project>

  <!--
    Druse — propiedades comunes a todos los proyectos del backend.
    Ver PLAN_TRABAJO_DRUSE.md §5 (Diseño del backend) y §12 (Seguridad).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      El modo de globalización invariante reduciría el tamaño del ejecutable,
      pero Microsoft.Data.SqlClient no arranca con él: falla al abrir cualquier
      conexión con «Globalization Invariant Mode is not supported».

      Tampoco encaja con lo que hace la aplicación: muestra datos de bases
      ajenas, con sus intercalaciones y alfabetos. Los valores se formatean con
      cultura invariante en cada proveedor, que es donde importa; apagar la
      globalización del proceso entero es otra cosa.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Metadatos del producto -->
  <PropertyGroup>
    <!--
      `Product` es el nombre del programa; `Company` y `Authors`, de quien lo
      hizo. Son cosas distintas aunque hasta ahora dijeran lo mismo, y aparecen
      en las propiedades del ejecutable que Windows enseña al usuario.
    -->
    <Product>Druse</Product>
    <Company>Darío Ramos</Company>
    <Authors>Darío Ramos</Authors>
    <Copyright>© 2026 Darío Ramos</Copyright>
    <Version>1.0.0</Version>
    <NeutralLanguage>es</NeutralLanguage>
  </PropertyGroup>

  <!--
    Portabilidad (plan §2): la base de código debe compilar para Windows, Linux y macOS
    en x64 y ARM64. Ningún proyecto puede fijar un RID aquí.
  -->
  <PropertyGroup>
    <EnableWindowsTargeting>false</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
