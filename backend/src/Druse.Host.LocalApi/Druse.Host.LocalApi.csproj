<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!--
      Referencia directa para elevar la dependencia transitiva de Microsoft.AspNetCore.OpenApi,
      que trae Microsoft.OpenApi 2.0.0 (CVE-2026-49451, GHSA-v5pm-xwqc-g5wc, CVSS 7.5).
      Parcheado a partir de 2.7.5. Revisar si una versión futura del SDK ya la eleva.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Druse.Application\Druse.Application.csproj" />
    <ProjectReference Include="..\Druse.Infrastructure\Druse.Infrastructure.csproj" />
    <ProjectReference Include="..\Druse.Provider.MySql\Druse.Provider.MySql.csproj" />
    <ProjectReference Include="..\Druse.Provider.PostgreSql\Druse.Provider.PostgreSql.csproj" />
    <ProjectReference Include="..\Druse.Provider.SqlServer\Druse.Provider.SqlServer.csproj" />
    <ProjectReference Include="..\Druse.Persistence.Sqlite\Druse.Persistence.Sqlite.csproj" />
    <ProjectReference Include="..\Druse.Platform.Native\Druse.Platform.Native.csproj" />
    <ProjectReference Include="..\Druse.Ssh\Druse.Ssh.csproj" />
  </ItemGroup>

  <!--
    Informix se puede dejar fuera del ejecutable que se reparte.

    Su driver son 111 MB —el clidriver nativo de IBM— y triplica el tamaño del
    paquete. Quien no use Informix no tiene por qué cargar con eso, así que
    `-p:IncludeInformix=false` produce una compilación sin ese proveedor.

    El proyecto se sigue compilando y probando siempre: lo que cambia es solo si
    el host lo referencia. Un motor que no se prueba acaba roto sin que nadie
    se entere.
  -->
  <ItemGroup>
    <!--
      El vigilante del proceso padre es interno —nadie fuera del host lo
      necesita—, pero es justo lo que hay que probar: sin él, una ventana que
      muere de golpe deja la API viva bloqueando sus propios archivos.
    -->
    <InternalsVisibleTo Include="Druse.IntegrationTests" />
  </ItemGroup>

  <PropertyGroup>
    <IncludeInformix Condition="'$(IncludeInformix)' == ''">true</IncludeInformix>
    <DefineConstants Condition="'$(IncludeInformix)' == 'true'">$(DefineConstants);DRUSE_INFORMIX</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(IncludeInformix)' == 'true'">
    <ProjectReference Include="..\Druse.Provider.Informix\Druse.Provider.Informix.csproj" />
  </ItemGroup>

</Project>
