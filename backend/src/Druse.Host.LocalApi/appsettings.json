      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LocalApi": {
    "Port": 5177
  },
  "AiChat": {
    "Defaults": {
      "MaxSqlBytes": 16384,
      "MaxSchemaBytes": 32768,
