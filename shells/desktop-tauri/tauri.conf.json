{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Druse",
  "version": "0.1.0",
  "identifier": "io.druse.desktop",
  "build": {
    "frontendDist": "../../frontend/dist/frontend/browser",
    "devUrl": "http://localhost:4200"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Druse",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0B0D11",
        "label": "main"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' http://127.0.0.1:* http://localhost:*",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "publisher": "Darío Ramos",
    "copyright": "© 2026 Darío Ramos",
    "shortDescription": "Cliente de bases de datos",
    "longDescription": "Administra y consulta PostgreSQL y SQL Server desde una interfaz moderna.",
    "resources": [
      "api/*",
      "api/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ]
      }
    }
  }
}
